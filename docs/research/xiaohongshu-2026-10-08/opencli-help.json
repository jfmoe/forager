{
  "checked_at": "2026-10-08T11:26:19.937759+00:00",
  "version": "1.8.6",
  "commands": [
    {
      "name": "comments",
      "command": "opencli xiaohongshu comments",
      "usage": "opencli xiaohongshu comments <note-id> [options]",
      "access": "read",
      "description": "获取小红书笔记评论（支持楼中楼子回复）",
      "browser": true,
      "domain": "www.xiaohongshu.com",
      "positionals": [
        {
          "name": "note-id",
          "type": "str",
          "positional": true,
          "required": true,
          "help": "Full Xiaohongshu note URL with xsec_token"
        }
      ],
      "command_options": [
        {
          "name": "limit",
          "type": "int",
          "default": 20,
          "help": "Number of top-level comments (max 50)"
        },
        {
          "name": "with-replies",
          "type": "boolean",
          "default": false,
          "help": "Include nested replies (楼中楼)"
        }
      ],
      "browser_common_options": [
        {
          "name": "window",
          "flags": "--window <mode>",
          "help": "Browser window mode: foreground or background",
          "choices": [
            "foreground",
            "background"
          ]
        },
        {
          "name": "site-session",
          "flags": "--site-session <mode>",
          "help": "Adapter site session lifecycle: ephemeral or persistent",
          "choices": [
            "ephemeral",
            "persistent"
          ]
        },
        {
          "name": "keep-tab",
          "flags": "--keep-tab <bool>",
          "help": "Keep the browser tab lease after the command finishes",
          "choices": [
            "true",
            "false"
          ]
        }
      ],
      "example": "opencli xiaohongshu comments <note-id> -f yaml",
      "columns": [
        "rank",
        "author",
        "userId",
        "profileUrl",
        "text",
        "likes",
        "time",
        "is_reply",
        "reply_to"
      ]
    },
