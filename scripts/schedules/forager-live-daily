#!/bin/bash
# The daily job: the free tier, then its notification decision.
notify() {
  osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
    -e 'end run' "$1" "$2"
}

for program in forager gh jq; do
  if ! command -v "$program" >/dev/null; then
    notify "forager daily job" "$program is not on PATH"
    exit 1
  fi
done

logs="$HOME/Library/Logs/forager"
mkdir -p "$logs"
report="$logs/live-free.json"
forager doctor --live --unattended --tier free --timeout 900 >"$report"
status=$?
"$(dirname "$0")/forager-live-issues" "$report" "$status"
